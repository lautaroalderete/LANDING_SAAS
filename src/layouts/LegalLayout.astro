---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { BRAND_NAME } from '../data/site';

interface Props {
  title: string;
  description: string;
  path: string;
  updated: string;
}
const { title, description, path, updated } = Astro.props;
// noindex: estas páginas tienen placeholders legales. Cuando el texto esté revisado,
// sacá `noindex` y sumá la ruta a src/pages/sitemap.xml.ts.
---

<BaseLayout title={`${title} | ${BRAND_NAME}`} description={description} path={path} noindex>
  <Header />
  <main id="contenido" class="px-4 py-12 sm:px-6 md:py-20">
    <article class="legal mx-auto max-w-3xl">
      <h1 class="text-4xl font-extrabold tracking-tight">{title}</h1>
      <p class="mt-2 text-sm text-muted">Última actualización: {updated}</p>
      <slot />
    </article>
  </main>
  <Footer />
</BaseLayout>

<style is:global>
  .legal h2 {
    margin-top: 2.5rem;
    font-size: 1.35rem;
    font-weight: 800;
  }
  .legal p,
  .legal ul {
    margin-top: 0.9rem;
    color: var(--color-muted);
    line-height: 1.7;
  }
  .legal ul {
    list-style: disc;
    padding-left: 1.25rem;
  }
  .legal a {
    color: var(--color-brand-700);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
