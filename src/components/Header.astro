---
import Logo from './Logo.astro';
import { BRAND_NAME, SIGNUP_URL } from '../data/site';

const links = [
  { href: '#como-funciona', label: 'Cómo funciona' },
  { href: '#precios', label: 'Precios' },
  { href: '#preguntas', label: 'Preguntas' },
];
---

<header class="sticky top-0 z-50 border-b border-line/80 bg-white/95 backdrop-blur-sm">
  <div class="container-page flex h-16 items-center justify-between gap-4 px-4 sm:px-6">
    <a href="/" class="rounded-md text-ink" aria-label={`${BRAND_NAME}, inicio`}>
      <Logo />
    </a>

    <nav aria-label="Secciones" class="hidden md:block">
      <ul class="flex items-center gap-8 text-[0.95rem] font-semibold text-muted">
        {
          links.map((link) => (
            <li>
              <a href={link.href} class="rounded-md py-2 transition-colors hover:text-ink">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a
      href={SIGNUP_URL}
      data-cta="header"
      class="inline-flex min-h-11 items-center justify-center rounded-lg bg-brand-600 px-4 text-[0.95rem] font-bold text-white transition-colors hover:bg-brand-700"
    >
      Probalo gratis
    </a>
  </div>
</header>
