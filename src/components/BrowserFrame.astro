---
// Marco de navegador liviano (solo CSS) para mostrar capturas de la app.
interface Props {
  class?: string;
  /** Texto de la barra de direcciones (decorativo). */
  address?: string;
}
const { class: className = '', address = 'app' } = Astro.props;
---

<div
  class:list={[
    'overflow-hidden rounded-2xl border border-ink/10 bg-white shadow-[0_30px_60px_-20px_rgb(15_23_42/0.25)]',
    className,
  ]}
>
  <div class="flex items-center gap-3 border-b border-line bg-paper px-4 py-2.5" aria-hidden="true">
    <span class="flex gap-1.5">
      <span class="size-2.5 rounded-full bg-[#f87171]"></span>
      <span class="size-2.5 rounded-full bg-[#fbbf24]"></span>
      <span class="size-2.5 rounded-full bg-[#4ade80]"></span>
    </span>
    <span class="truncate rounded-md bg-white px-3 py-0.5 text-xs text-muted ring-1 ring-line">
      {address}
    </span>
  </div>
  <slot />
</div>
