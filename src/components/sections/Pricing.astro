---
// 6. PRECIOS — en pesos, finales. Sin JavaScript:
// - Toggle Mensual/Anual: radios + :has(). Ambos precios están en el HTML; si el navegador
//   no soporta :has(), se ve el mensual.
// - En mobile se ve una tarjeta por vez (selector de plan, arranca en la destacada) para que
//   la sección entre en una pantalla. En desktop se ven las tres. Sin soporte de :has(),
//   el selector se oculta y se ven las tres apiladas.
import Check from '@lucide/astro/icons/check';
import MessageCircle from '@lucide/astro/icons/message-circle';
import Users from '@lucide/astro/icons/users';
import Package from '@lucide/astro/icons/package';
import { PLANS, PRICING_FOOTNOTE, formatARS } from '../../data/pricing';
import { CONTACT, SIGNUP_URL, whatsappLink } from '../../data/site';
---

<section id="precios" class="section bg-paper" aria-labelledby="precios-title">
  <div class="pricing container-page">
    <div class="mx-auto max-w-2xl text-center">
      <p class="eyebrow">Precios</p>
      <h2 id="precios-title" class="h2 mt-2">Precios claros, en pesos.</h2>
      <p class="lead mt-3 max-sm:text-base">
        Todos los planes arrancan con <strong class="font-bold text-ink">14 días gratis con todas las funciones</strong>.
        Sin tarjeta.
      </p>
    </div>

    <fieldset class="mx-auto mt-5 flex w-fit rounded-full bg-white p-1 shadow-sm ring-1 ring-line md:mt-8">
      <legend class="sr-only">Forma de pago</legend>
      <input type="radio" name="billing" id="billing-monthly" value="mensual" class="sr-only" checked />
      <label for="billing-monthly" class="billing-option">Mensual</label>
      <input type="radio" name="billing" id="billing-annual" value="anual" class="sr-only" />
      <label for="billing-annual" class="billing-option">
        Anual <span class="billing-badge">2 meses gratis</span>
      </label>
    </fieldset>

    <fieldset class="plan-picker mt-4">
      <legend class="sr-only">Ver plan</legend>
      <div class="grid grid-cols-3 gap-1 rounded-xl border border-line bg-white p-1">
        {
          PLANS.map((plan) => (
            <>
              <input
                type="radio"
                name="plan"
                id={`plan-${plan.id}`}
                value={plan.id}
                class="sr-only"
                checked={Boolean(plan.highlight)}
              />
              <label for={`plan-${plan.id}`} class="plan-option">
                {plan.name}
              </label>
            </>
          ))
        }
      </div>
    </fieldset>

    <ul class="mt-6 grid gap-4 md:mt-10 md:grid-cols-3 md:items-stretch md:gap-6">
      {
        PLANS.map((plan) => {
          const featured = Boolean(plan.highlight);
          return (
            <li
              data-plan={plan.id}
              class:list={[
                'plan-card relative flex flex-col rounded-[var(--radius-card)] bg-white p-5 md:p-7',
                featured
                  ? 'shadow-[0_24px_50px_-20px_rgb(8_132_63/0.45)] ring-2 ring-brand-600 md:-my-3 md:py-10'
                  : 'ring-1 ring-line',
              ]}
            >
              {featured && (
                <p class="absolute -top-3.5 left-6 rounded-full bg-brand-600 px-3 py-1 text-xs font-bold tracking-wide text-white uppercase">
                  {plan.highlight}
                </p>
              )}
              <h3 class="text-xl font-extrabold">{plan.name}</h3>
              <p class="mt-1 text-[0.95rem] text-muted">{plan.intro}</p>

              <div class="mt-4 md:mt-5 md:min-h-[5.5rem]">
                {plan.monthly === null ? (
                  <p class="text-4xl font-extrabold tracking-tight">A medida</p>
                ) : (
                  <>
                    <div class="price-monthly">
                      <p>
                        <span class="text-4xl font-extrabold tracking-tight">{formatARS(plan.monthly)}</span>
                        <span class="font-semibold text-muted">/mes</span>
                      </p>
                    </div>
                    <div class="price-annual">
                      {plan.annual !== null ? (
                        <>
                          <p>
                            <span class="text-4xl font-extrabold tracking-tight">{formatARS(plan.annual)}</span>
                            <span class="font-semibold text-muted">/año</span>
                          </p>
                          <p class="mt-1 text-sm font-semibold text-brand-700">
                            {plan.annualNote} · equivale a {formatARS(Math.round(plan.annual / 12))}/mes
                          </p>
                        </>
                      ) : (
                        <>
                          <p>
                            <span class="text-4xl font-extrabold tracking-tight">{formatARS(plan.monthly)}</span>
                            <span class="font-semibold text-muted">/mes</span>
                          </p>
                          <p class="mt-1 text-sm font-semibold text-muted">Pago mensual</p>
                        </>
                      )}
                    </div>
                  </>
                )}
              </div>

              <dl class="mt-3 flex flex-wrap gap-x-5 gap-y-1 rounded-lg bg-paper px-3 py-2 text-sm font-semibold md:mt-4">
                <div>
                  <dt class="sr-only">Usuarios</dt>
                  <dd class="flex items-center gap-1.5">
                    <Users size={16} class="text-muted" />
                    {plan.users}
                  </dd>
                </div>
                <div>
                  <dt class="sr-only">Productos</dt>
                  <dd class="flex items-center gap-1.5">
                    <Package size={16} class="text-muted" />
                    {plan.products}
                  </dd>
                </div>
              </dl>

              <ul class="mt-4 space-y-2 text-[0.95rem] md:mt-5 md:space-y-2.5">
                {plan.features.map((feature) => (
                  <li class="flex gap-2.5">
                    <Check size={20} stroke-width={2.5} class="mt-0.5 shrink-0 text-brand-600" />
                    <span>{feature}</span>
                  </li>
                ))}
              </ul>

              <div class="mt-auto pt-5 md:pt-7">
                {plan.cta.kind === 'signup' ? (
                  <a
                    href={SIGNUP_URL}
                    data-cta={`precios-${plan.id}`}
                    class:list={[featured ? 'btn-primary' : 'btn-secondary', 'w-full']}
                  >
                    {plan.cta.label}
                  </a>
                ) : (
                  <>
                    <a
                      href={whatsappLink('Hola, quiero información sobre el plan Empresa.')}
                      data-cta="precios-empresa"
                      class="btn-secondary w-full"
                    >
                      <MessageCircle size={20} />
                      {plan.cta.label}
                    </a>
                    <p class="mt-2 text-center text-sm text-muted">
                      o llamanos al{' '}
                      <a href={`tel:${CONTACT.phoneE164}`} class="rounded font-semibold text-ink underline underline-offset-2">
                        {CONTACT.phoneDisplay}
                      </a>
                    </p>
                  </>
                )}
              </div>
            </li>
          );
        })
      }
    </ul>

    <p class="mt-6 text-center text-sm text-muted md:mt-8">{PRICING_FOOTNOTE}</p>
  </div>
</section>

<style>
  /* Toggle mensual/anual sin JS */
  .billing-option {
    display: inline-flex;
    min-height: 2.75rem;
    cursor: pointer;
    align-items: center;
    gap: 0.5rem;
    border-radius: 9999px;
    padding: 0 1.1rem;
    font-weight: 700;
    color: var(--color-muted);
    transition:
      background-color 0.15s,
      color 0.15s;
  }
  input:checked + .billing-option {
    background: var(--color-ink);
    color: #fff;
  }
  input:focus-visible + .billing-option {
    outline: 3px solid var(--color-brand-600);
    outline-offset: 2px;
  }
  .billing-badge {
    border-radius: 9999px;
    background: var(--color-brand-100);
    padding: 0.1rem 0.5rem;
    font-size: 0.75rem;
    color: var(--color-brand-800);
  }
  .price-annual {
    display: none;
  }
  .pricing:has(#billing-annual:checked) .price-annual {
    display: block;
  }
  .pricing:has(#billing-annual:checked) .price-monthly {
    display: none;
  }

  /* Selector de plan (solo mobile y solo si el navegador soporta :has) */
  .plan-picker {
    display: none;
  }
  .plan-option {
    display: grid;
    min-height: 2.75rem;
    cursor: pointer;
    place-items: center;
    border-radius: 0.6rem;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-muted);
  }
  input:checked + .plan-option {
    background: var(--color-brand-50);
    color: var(--color-brand-800);
    box-shadow: inset 0 0 0 2px var(--color-brand-600);
  }
  input:focus-visible + .plan-option {
    outline: 3px solid var(--color-brand-600);
    outline-offset: 2px;
  }
  @supports selector(:has(*)) {
    @media (width < 48rem) {
      .plan-picker {
        display: block;
      }
      .plan-card {
        display: none;
      }
      .pricing:has(#plan-basico:checked) .plan-card[data-plan='basico'],
      .pricing:has(#plan-profesional:checked) .plan-card[data-plan='profesional'],
      .pricing:has(#plan-empresa:checked) .plan-card[data-plan='empresa'] {
        display: flex;
      }
    }
  }
</style>
