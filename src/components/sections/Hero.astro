---
// 1. HERO — el <h1> nombra el problema (plata), no el software.
//
// Variantes evaluadas para el <h1>:
//   A) "Dejá de perder plata por stock que no sabés que tenés."   ← elegida
//   B) "Cada faltante es un cliente que se va a comprar a otro lado."
//   C) "Vendés todo el día y no sabés cuánto ganás."
// Elegimos A: nombra la pérdida de plata y la causa en una sola frase, y contiene
// "stock", la palabra que busca el cliente. B y C sirven como títulos de anuncios.
import { Picture } from 'astro:assets';
import CtaButton from '../CtaButton.astro';
import BrowserFrame from '../BrowserFrame.astro';
// [CAPTURA_DASHBOARD.webp] — reemplazá src/assets/captura-dashboard.png por una captura real
// del dashboard (ideal 1600×1000, 16:10). Astro la convierte a AVIF/WebP en el build.
import capturaDashboard from '../../assets/captura-dashboard.png';
---

<section class="relative overflow-hidden px-4 pt-8 pb-14 sm:px-6 md:pt-16 md:pb-24" aria-labelledby="hero-title">
  <div
    class="pointer-events-none absolute -top-40 -right-40 size-[36rem] rounded-full bg-brand-50"
    aria-hidden="true">
  </div>

  <div class="container-page relative grid items-center gap-10 lg:grid-cols-[1fr_1.1fr] lg:gap-14">
    <div class="max-w-xl">
      <p class="eyebrow">Sistema de stock y ventas para comercios</p>
      <h1
        id="hero-title"
        class="mt-3 text-[2.35rem] leading-[1.05] font-extrabold tracking-tight text-balance sm:text-5xl lg:text-[3.6rem]"
      >
        Dejá de perder plata por stock que no sabés que tenés.
      </h1>
      <p class="mt-5 text-lg text-pretty text-muted sm:text-xl">
        Controlá stock, ventas y compras desde el celular. Escaneás, vendés y el sistema hace las cuentas.
      </p>
      <CtaButton location="hero" microcopy block class="mt-8" />
    </div>

    <div class="lg:-mr-24">
      <BrowserFrame address="Dashboard">
        <Picture
          src={capturaDashboard}
          formats={['avif', 'webp']}
          fallbackFormat="webp"
          widths={[480, 800, 1200, 1600]}
          sizes="(min-width: 1024px) 680px, calc(100vw - 2rem)"
          alt="Dashboard del sistema: indicadores de ventas del período, gráfico de ventas por día y la lista de productos por debajo del stock mínimo."
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="block h-auto w-full"
        />
      </BrowserFrame>
    </div>
  </div>
</section>
