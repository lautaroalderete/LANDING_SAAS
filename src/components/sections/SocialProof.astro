---
// 7. PRUEBA SOCIAL
// Todavía no hay clientes con testimonios: NO se inventan testimonios, nombres, logos ni métricas.
// - Modo 'beta' (por defecto): bloque "Buscamos 5 comercios para el programa beta".
// - Modo 'testimonios': 3 tarjetas que se completan con beta testers reales
//   (ver src/data/testimonials.ts). Se cambia en src/data/site.ts → SOCIAL_PROOF_MODE.
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import MessageCircle from '@lucide/astro/icons/message-circle';
import { SOCIAL_PROOF_MODE, CONTACT, whatsappLink } from '../../data/site';
import { TESTIMONIALS } from '../../data/testimonials';

// Fotos de testimonios: se toman de src/assets/testimonios/ por nombre de archivo.
const photos = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/testimonios/*.{jpg,jpeg,png,webp,avif}',
  { eager: true },
);
const photoFor = (file: string | null) =>
  file ? photos[`/src/assets/testimonios/${file}`]?.default : undefined;
---

{
  SOCIAL_PROOF_MODE === 'beta' ? (
    <section class="section" aria-labelledby="beta-title">
      <div class="container-page">
        <div class="mx-auto max-w-3xl rounded-[var(--radius-card)] border-2 border-dashed border-brand-300 bg-brand-50 px-6 py-10 text-center md:px-12 md:py-14">
          <p class="eyebrow">Programa beta</p>
          <h2 id="beta-title" class="h2 mt-2">Buscamos 5 comercios para el programa beta.</h2>
          <p class="lead mx-auto mt-4 max-w-xl">
            Usás el sistema gratis a cambio de tu opinión. Nos contás qué te sirve y qué no, y con eso lo mejoramos.
          </p>
          <div class="mt-7 flex flex-col items-center gap-3">
            <a
              href={whatsappLink('Hola, quiero sumarme al programa beta.')}
              data-cta="beta"
              class="btn-secondary w-full sm:w-auto"
            >
              <MessageCircle size={20} />
              Quiero sumarme a la beta
            </a>
            <p class="text-sm text-muted">
              Escribinos por WhatsApp o llamanos al{' '}
              <a href={`tel:${CONTACT.phoneE164}`} class="rounded font-semibold text-ink underline underline-offset-2">
                {CONTACT.phoneDisplay}
              </a>
            </p>
          </div>
        </div>
      </div>
    </section>
  ) : (
    <section class="section" aria-labelledby="testimonios-title">
      <div class="container-page">
        <div class="max-w-2xl">
          <p class="eyebrow">Lo que dicen los comercios</p>
          <h2 id="testimonios-title" class="h2 mt-2">
            {/* [TÍTULO TESTIMONIOS] — ajustar cuando estén los testimonios reales */}
            Comercios que ya controlan su stock.
          </h2>
        </div>
        <ul class="mt-8 grid gap-4 md:mt-12 md:grid-cols-3 md:gap-6">
          {TESTIMONIALS.map((t) => {
            const photo = photoFor(t.photo);
            return (
              <li class="flex flex-col rounded-[var(--radius-card)] border border-line bg-white p-6">
                <blockquote class="text-lg leading-snug font-semibold">
                  <p>“{t.quote}”</p>
                </blockquote>
                <div class="mt-auto flex items-center gap-3 pt-6">
                  {photo ? (
                    <Picture
                      src={photo}
                      formats={['avif', 'webp']}
                      fallbackFormat="webp"
                      width={56}
                      height={56}
                      densities={[1, 2]}
                      alt={`Foto de ${t.name}`}
                      loading="lazy"
                      decoding="async"
                      class="size-14 rounded-full object-cover"
                    />
                  ) : (
                    <span
                      class="grid size-14 shrink-0 place-items-center rounded-full bg-paper text-muted ring-1 ring-line"
                      aria-hidden="true"
                    >
                      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="8" r="4" />
                        <path d="M4 21a8 8 0 0 1 16 0" />
                      </svg>
                    </span>
                  )}
                  <p class="text-sm">
                    <span class="block font-bold">{t.name}</span>
                    <span class="text-muted">
                      {t.business} · {t.city}
                    </span>
                  </p>
                </div>
              </li>
            );
          })}
        </ul>
      </div>
    </section>
  )
}
